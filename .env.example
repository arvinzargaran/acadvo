# ── TLS / domains (docker-compose.prod.yml) ─────────────────────────
# Caddy terminates TLS and obtains Let's Encrypt certificates automatically.
# Both names must already resolve to this host's public IP before you start the
# stack, or the ACME challenge fails.
#
# Use two names under ONE registrable domain (acadvo.app + api.acadvo.app).
# That keeps app -> API requests same-site, so the SameSite=lax auth cookies are
# still sent while genuine cross-site CSRF attempts stay blocked. Two unrelated
# domains would force COOKIE_SAMESITE=none, which the app refuses to start with.
APP_DOMAIN=your-domain.com
API_DOMAIN=api.your-domain.com
ACME_EMAIL=you@your-domain.com

# Database
DATABASE_URL=postgresql+asyncpg://acadvo:STRONG_PASSWORD_HERE@db:5432/acadvo
DATABASE_URL_SYNC=postgresql://acadvo:STRONG_PASSWORD_HERE@db:5432/acadvo
POSTGRES_USER=acadvo
POSTGRES_PASSWORD=STRONG_PASSWORD_HERE
POSTGRES_DB=acadvo

# Auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Groq — get a key at https://console.groq.com/keys (required for all AI features)
GROQ_API_KEY=your-groq-key-here

# Model ids, and the one setting that keeps the vision model usable.
#
# Groq RETIRES hosted models. When it does, every AI call returns 404 and the
# whole AI surface fails at once with nothing naming the cause — this has
# already happened here once, to the entire Llama family the app was built on.
# Before blaming the app, check the ids against:
#     curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# Leave these unset to use the defaults in backend/app/config.py.
#GROQ_MODEL=openai/gpt-oss-120b
#GROQ_VISION_MODEL=qwen/qwen3.6-27b
# "none" turns off the vision model's inline reasoning, which otherwise eats the
# whole completion budget and returns no JSON at all. Only "none" or "default"
# are accepted for Qwen; set it empty for a model that rejects the parameter.
#GROQ_VISION_REASONING_EFFORT=none
# Ceiling on prompt + completion for one request; 0 (the default) means none.
# Groq's per-minute token limit is ALSO a per-request limit, so on the free tier
# (8,000 TPM) the semester planner's 8k completion budget is refused every single
# time with a 413. Set this to your account's TPM and the planner trims its
# budget to fit instead of failing. Leave it at 0 on a paid tier.
#GROQ_MAX_REQUEST_TOKENS=8000
# Reasoning effort for the JSON-producing calls (plans, search, parsing). Left at
# the model's default, a reasoning model can spend the ENTIRE completion budget
# thinking and return nothing — measured: 4,631 tokens of reasoning and zero
# characters of plan. Empty string omits the parameter.
#GROQ_JSON_REASONING_EFFORT=low

# Gemini — get a key at https://aistudio.google.com/apikey
#
# OPTIONAL, and only used for one thing: reading a university's public pages to
# work out what satisfies a requirement bucket ("6.00 credits in AP/HUMA"), which
# is prose on a calendar page rather than data in any API. Groq cannot browse,
# so this needs a provider with server-side search grounding.
#
# Leave it unset and everything else works exactly as before — the app simply
# will not say which requirement a course satisfies, which is the honest answer
# when it has not read the university's rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Let the model FIND requirement pages itself instead of only reading ones it is
# given. This is Google Search grounding: a BILLED feature. On the free tier every
# grounded call returns 429 no matter which model you pick, so leave this False
# unless billing is enabled on your Google Cloud project. With it False, students
# supply their program's requirements URL and the (free) url_context tool reads it.
RESEARCH_USE_SEARCH_GROUNDING=False

# How many days a researched requirement rule is trusted before it is re-checked
# in the background. Calendars are republished annually; a stale rule is still
# served (and flagged), never withheld.
REQUIREMENT_RULE_TTL_DAYS=180

# Email — used for password reset & verification links. If SMTP_HOST is empty,
# emails are logged to the server instead of sent (fine for local dev).
FRONTEND_URL=https://your-domain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=True
EMAIL_FROM=no-reply@your-domain.com
EMAIL_FROM_NAME=Acadvo

# Rate limiting — leave empty for in-memory (per-process; fine for a single
# worker/local dev). With multiple workers, limits must use a shared store or
# they count per-worker. docker-compose.prod.yml runs a redis service and sets
# RATE_LIMIT_STORAGE_URI=redis://redis:6379 automatically, so you can leave this
# empty there. Set it yourself only for a non-compose deployment.
RATE_LIMIT_STORAGE_URI=

# Public base URL of the backend API itself — used to build the .ics calendar
# feed URL that gets subscribed to from Google/Apple/Outlook calendars.
PUBLIC_API_URL=https://api.your-domain.com

# Frontend. Baked into the JS bundle AND into the CSP's connect-src at image
# build time, so it must be the API's real public origin — if it is wrong, the
# app's own Content-Security-Policy blocks every request it makes.
VITE_API_URL=https://api.your-domain.com

# CORS — set to your production domain(s), comma-separated. This is the origin
# the browser loads the APP from, not the API.
CORS_ORIGINS=https://your-domain.com

# Cookies — MUST be True in production (requires HTTPS). The app refuses to
# start with COOKIE_SECURE=False or COOKIE_SAMESITE=none when DEBUG=False.
COOKIE_SECURE=True
COOKIE_SAMESITE=lax

# Set DEBUG=True only in development (enables /docs, /redoc)
DEBUG=False

# Set BEHIND_PROXY=True when running behind nginx/Caddy/load balancer
# so rate limiting uses the real client IP from X-Forwarded-For.
# docker-compose.prod.yml sets this to True for you (Caddy sits in front).
BEHIND_PROXY=False

# IPs/networks uvicorn trusts X-Forwarded-For from (passed to
# --forwarded-allow-ips). Because Caddy runs as a CONTAINER, the trusted peer is
# its address on the compose network — not loopback — so docker-compose.prod.yml
# defaults this to the fixed 172.28.0.0/16 subnet it declares. Only override it
# for a non-compose deployment, and NEVER set it to '*': that lets any client
# spoof their IP and bypass rate limiting entirely.
FORWARDED_ALLOW_IPS=172.28.0.0/16

# Error tracking (Sentry) — leave SENTRY_DSN empty to disable entirely (no SDK
# initialisation, zero runtime cost). Set it to your project DSN to enable.
# SENTRY_TRACES_SAMPLE_RATE controls performance tracing (0.0 = errors only).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
