# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Node
node_modules/
frontend/dist/

# Environment
.env
.env.local
.env.production

# Logs (runtime output should never be versioned)
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Docker
docker-compose.override.yml

# Alembic
*.pyc

# Testing
.coverage
htmlcov/
.pytest_cache/

# Database dumps (scripts/backup-db.sh) — real user data, never versioned.
backups/

# ── Pre-publication hardening ────────────────────────────────────────
# Key material. None of this has ever been committed here; these patterns
# exist so a stray file can never become the first time.
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_ed25519
*.crt

# Every dotenv variant, except the checked-in template. `.env` alone missed
# `.env.staging`, `backend/.env.local`, and anything else a future variant is
# called; a leading `*` would have caught the real secrets sitting in ./.env
# and ./backend/.env only by luck of naming.
.env*
!.env.example

# Local databases and dumps — real data, never versioned.
*.sqlite
*.sqlite3
*.db
*.sql.gz

# Superseded planning notes kept on disk for reference, not versioned.
pathfinder-overview.txt

# Intermediate recording from scripts/record-landing.mjs. The committed GIF and
# mp4 are generated from it; the raw capture is not worth versioning.
docs/media/*.webm
